{
  "name": "totalshedsolutions",
  "version": "1.0",
  "private": true,
  "description": "Total Shed Solutions Australia",
  "author": "Sam Ilic",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "npm run clean:build && npm run build",
    "start": "next dev",
    "preview": "serve bin",
    "lint": "eslint ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean:build": "rimraf .next && rimraf bin",
    "clean:packages": "rimraf package-lock.json && rimraf node_modules",
    "upgrade": "ncu -u && npm run clean:packages && npm install"
  },
  "dependencies": {
    "@next/third-parties": "16.2.10",
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "1.25.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "typescript": "7.0.2"
  }
}
